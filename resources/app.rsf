BasicInfo:
  Title: "3DS App Store"
  CompanyCode: "00"
  ProductCode: "CTR-P-HAPP"
  ContentType: Application
  Logo: Homebrew

TitleInfo:
  UniqueId: 0xF8001
  Category: Application

Option:
  UseOnSD: true
  FreeProductCode: true
  MediaFootPadding: false
  EnableCrypt: false
  EnableCompress: true

RomFs:
  RootPath: $(ROMFS_PATH)

